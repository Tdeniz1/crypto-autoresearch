# Copy to .env and fill in. .env is gitignored. Never put the holdout dir here.

# Rung 1 — OpenRouter (free models). https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Rung 2 — Claude Code headless. Generate with `claude setup-token` (long-lived OAuth token).
# When set, rung 2 runs `claude -p --bare` and survives unattended. If unset it falls back to
# the interactive keychain login of the machine running the loop.
CLAUDE_CODE_OAUTH_TOKEN=

# Rung 3 — Anthropic API direct. Hard-capped per session by RUNG3_SESSION_USD_CAP in harness/config.py.
ANTHROPIC_API_KEY=

# Report narrative model (optional; report.py). Falls back to the tables-only report without it.
# Uses ANTHROPIC_API_KEY above. Model set in harness/config.py REPORT_MODEL.

# Paper trading stub (live/executor.py). Not used by the research loop.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- NOT an env var for this file ---
# CRYPTO_HOLDOUT_DIR must ONLY be set on the shell that runs prepare.py or scripts/run_holdout.py.
# The runner aborts if it sees it. Keep it out of .env so `dotenv` can never load it into the loop.

# --- live alerting (live/alerter.py) ---
# ntfy.sh topic you subscribe to in the ntfy app. Topics are public by name: use a long random one.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
ALERTER_CHANNELS=ntfy,macos
ALERTER_EQUITY_USD=10000
ALERTER_RISK_FRACTION=0.10
# paper vs live credentials (same code path; orders are never placed by the alerter)
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_API_SECRET=
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_API_SECRET=
